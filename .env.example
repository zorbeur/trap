PORT=3000

# Configuration Principale (EmailJS)
EMAILJS_PUBLIC_KEY=votre_public_key
EMAILJS_PRIVATE_KEY=votre_private_key
EMAILJS_SERVICE_ID=votre_service_id
EMAILJS_TEMPLATE_ID=votre_template_id

# Configuration de Secours / Fallback (ex: SMTP de Gmail, Brevo, Mailgun, ou Mailtrap)
# Ce service prendra le relais automatiquement si EmailJS est hors ligne
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=votre_utilisateur_smtp
SMTP_PASS=votre_mot_de_passe_smtp
SMTP_FROM_EMAIL=no-reply@votreapp.com

# Sécurité
INTERNAL_API_KEY=mon_secret_api_123

